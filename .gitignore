# 运行时数据目录：Agent 的产物（站点配置、部署记录、构建产物、日志、凭证等）
# 属本地业务数据，非开源内容；其中 docs/config.json 含明文密钥/token，一并忽略
docs/

# node_modules 全局兜底（建站工具链、构建产物等）
node_modules/

# 系统杂物
.DS_Store

# Claude Code 个人本地配置（含 autoMemoryDirectory，机器本地，不提交）
.claude/settings.local.json

# hook 运行时状态文件（memory 变更标记 / diff checkpoint，机器本地）
.claude/.memory-changed-this-session
.claude/.last-memory-checkpoint

# 临时产物（见 .claude/rules/tmp-dir-for-artifacts.md）
tmp/

# playwright-cli 浏览器自动化的本机调试产物（console 日志 / 页面快照，运行时生成，非源码）
.playwright-cli/


# 产物接力目录（含可售卖成品 / 站点源码快照，勿公开）
artifacts/

# Python 缓存
__pycache__/
*.pyc

# 本机密钥通用兜底（保留 .env.example）
.env
.env.*
!.env.example

# 落地页本机运行时配置（GA4 / Pixel / CF token / 购买链接真实值，见 site/config.example.js）
site/config.js

# Python 编译缓存
__pycache__/
